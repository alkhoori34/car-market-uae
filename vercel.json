{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/car/:id",
      "destination": "/api/page?route=/car/:id"
    },
    {
      "source": "/used-cars",
      "destination": "/api/page?route=/used-cars"
    },
    {
      "source": "/used-cars/:a",
      "destination": "/api/page?route=/used-cars/:a"
    },
    {
      "source": "/used-cars/:a/:b",
      "destination": "/api/page?route=/used-cars/:a/:b"
    },
    {
      "source": "/terms",
      "destination": "/api/page?route=/terms"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?route=/privacy"
    },
    {
      "source": "/contact",
      "destination": "/api/page?route=/contact"
    },
    {
      "source": "/blog",
      "destination": "/api/page?route=/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?route=/blog/:slug"
    },
    {
      "source": "/vin-check",
      "destination": "/api/page?route=/vin-check"
    },
    {
      "source": "/dealer/:slug",
      "destination": "/api/page?route=/dealer/:slug"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
